---
import { siteConfig } from '../data/siteConfig';
import content from '../data/content.json';
const { part, fill } = Astro.props;
const { services, hoods } = content;
const brand = siteConfig.brand;
const [b1, b2, b3] = [siteConfig.brandCity, 'Hydro Jetting', 'Pros'];
const phone = siteConfig.phoneDisplay;
const tel = 'tel:' + siteConfig.phoneHref;
const phoneIcon = '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const drop = '<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2.7s6.5 6.6 6.5 11.3a6.5 6.5 0 0 1-13 0C5.5 9.3 12 2.7 12 2.7z" stroke-linejoin="round"/></svg>';
---
{part === 'header' && (
<>
<a class="skip" href="#main">Skip to content</a>
<header class="hdr" data-hdr>
  <div class="hdr-in">
    <a class="brand" href="/" aria-label={brand + ' home'}><span class="brand-ico" set:html={drop} /><span class="brand-txt">{b1}{" "}<em>{b2}</em>{" "}{b3}</span></a>
    <button class="menu-btn" type="button" data-menu aria-expanded="false" aria-label="Toggle menu"><span></span><span></span><span></span></button>
    <nav class="nav" data-nav aria-label="Main navigation">
      <a href="/">Home</a>
      <div class="dd"><button type="button" class="dd-btn" aria-expanded="false">Services <span aria-hidden="true">&#8964;</span></button>
        <div class="dd-menu">{services.map(([n, s]) => <a href={`/${s}/`}>{n}</a>)}</div></div>
      {hoods.length > 0 && <div class="dd"><button type="button" class="dd-btn" aria-expanded="false">Service Areas <span aria-hidden="true">&#8964;</span></button>
        <div class="dd-menu">{hoods.map(([n, s]) => <a href={`/${s}/`}>{n}</a>)}</div></div>}
      <a href="/how-hydro-jetting-works/">How it works</a>
      <a href="#request">Contact</a>
      <a class="btn btn-primary nav-call" href={tel} aria-label={`Call ${brand} at ${phone}`}><span set:html={phoneIcon} />{phone}</a>
    </nav>
  </div>
</header>
</>
)}
{part === 'footer' && (
<>
<footer class="ftr">
  <div class="ftr-in">
    <div class="ftr-brand"><a class="brand" href="/"><span class="brand-ico" set:html={drop} /><span class="brand-txt">{b1}{" "}<em>{b2}</em>{" "}{b3}</span></a>
      <p>{fill(content.footerBlurb)}</p></div>
    <div><h4>Guides</h4>{content.guides.map(([n, s]) => <a href={`/${s}/`}>{n}</a>)}</div>
    {hoods.length > 0 && <div><h4>Service Areas</h4>{hoods.map(([n, s]) => <a href={`/${s}/`}>{n}</a>)}</div>}
    <div><h4>Services</h4>{services.map(([n, s]) => <a href={`/${s}/`}>{n}</a>)}<a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div>
  </div>
  <div class="ftr-copy">(c) 2026 {brand}. No service or result is guaranteed.</div>
</footer>
<a class="fab-deal" href={tel} aria-label={`Call ${brand} at ${phone}`}><span class="fab-deal-ico" aria-hidden="true" set:html={phoneIcon} /><span class="fab-deal-text"><span class="fab-deal-text-k">{brand}</span><span class="fab-deal-text-v">{phone}</span></span></a>
</>
)}
